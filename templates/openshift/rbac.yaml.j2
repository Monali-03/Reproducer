# RBAC: Role + RoleBinding for reproducer service account
# Generated by Red Hat Reproducer Agent
#
# This grants the service account permissions within the namespace,
# typically needed for JGroups Kubernetes discovery (view pods).
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: {{ role_name | default('reproducer-role') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
rules:
  - apiGroups: [""]
    resources:
{% for resource in role_resources | default(['pods']) %}
      - {{ resource }}
{% endfor %}
    verbs:
{% for verb in permissions | default(['get', 'list', 'watch']) %}
      - {{ verb }}
{% endfor %}
{% for rule in additional_rules | default([]) %}
  - apiGroups:
{% for group in rule.apiGroups | default(['']) %}
      - "{{ group }}"
{% endfor %}
    resources:
{% for resource in rule.resources %}
      - {{ resource }}
{% endfor %}
    verbs:
{% for verb in rule.verbs %}
      - {{ verb }}
{% endfor %}
{% endfor %}
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: {{ rolebinding_name | default('reproducer-rolebinding') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
subjects:
  - kind: ServiceAccount
    name: {{ sa_name | default('reproducer-sa') }}
    namespace: {{ namespace | default('reproducer') }}
{% for subject in additional_subjects | default([]) %}
  - kind: {{ subject.kind | default('ServiceAccount') }}
    name: {{ subject.name }}
    namespace: {{ subject.namespace | default(namespace | default('reproducer')) }}
{% endfor %}
roleRef:
  kind: Role
  name: {{ role_name | default('reproducer-role') }}
  apiGroup: rbac.authorization.k8s.io
