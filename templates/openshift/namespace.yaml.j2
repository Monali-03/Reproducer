# Namespace / Project for reproducer environment
# Generated by Red Hat Reproducer Agent
apiVersion: v1
kind: Namespace
metadata:
  name: {{ namespace | default('reproducer') }}
  labels:
    app: reproducer
{% if additional_labels | default({}) %}
{% for key, value in (additional_labels | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if annotations | default({}) %}
  annotations:
{% for key, value in (annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
