# StatefulSet for Data Grid cluster
# Generated by Red Hat Reproducer Agent
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: {{ statefulset_name | default('datagrid') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('datagrid') }}
spec:
  serviceName: {{ service_name | default('datagrid') }}
  replicas: {{ replicas | default(2) }}
  selector:
    matchLabels:
      app: {{ app_label | default('datagrid') }}
  updateStrategy:
    type: {{ update_strategy | default('RollingUpdate') }}
  podManagementPolicy: {{ pod_management_policy | default('OrderedReady') }}
  template:
    metadata:
      labels:
        app: {{ app_label | default('datagrid') }}
{% if pod_annotations | default({}) %}
      annotations:
{% for key, value in (pod_annotations | default({})).items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
    spec:
{% if sa_name | default('') %}
      serviceAccountName: {{ sa_name }}
{% endif %}
      containers:
        - name: {{ container_name | default('datagrid') }}
          image: {{ image | default('registry.redhat.io/datagrid/datagrid-8-rhel8:latest') }}
          imagePullPolicy: {{ image_pull_policy | default('IfNotPresent') }}
          ports:
            - name: hotrod
              containerPort: 11222
              protocol: TCP
            - name: ping
              containerPort: {{ jgroups_port | default(7800) }}
              protocol: TCP
          env:
            - name: USER
              value: "{{ dg_user | default('admin') }}"
            - name: PASS
              value: "{{ dg_password | default('changeit') }}"
            - name: JAVA_OPTIONS
              value: "{{ java_opts | default('-Xms256m -Xmx512m') }}"
            - name: INFINISPAN_SERVER_DEFAULTS
              value: "{{ server_defaults | default('') }}"
{% if cluster_transport | default('kubernetes') == 'kubernetes' %}
            # Kubernetes-based cluster discovery
            - name: KUBERNETES_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: KUBERNETES_LABELS
              value: "app={{ app_label | default('datagrid') }}"
{% endif %}
{% for env in env_vars | default([]) %}
            - name: {{ env.name }}
{% if env.value is defined %}
              value: "{{ env.value }}"
{% elif env.valueFrom is defined %}
              valueFrom:
{% if env.valueFrom.secretKeyRef is defined %}
                secretKeyRef:
                  name: {{ env.valueFrom.secretKeyRef.name }}
                  key: {{ env.valueFrom.secretKeyRef.key }}
{% endif %}
{% endif %}
{% endfor %}
          resources:
            requests:
              cpu: {{ cpu_request | default('500m') }}
              memory: {{ memory_request | default('512Mi') }}
            limits:
              cpu: {{ cpu_limit | default('1000m') }}
              memory: {{ memory_limit | default('1Gi') }}
          readinessProbe:
            httpGet:
              path: {{ readiness_path | default('/rest/v2/cache-managers/default/health/status') }}
              port: 11222
{% if dg_user | default('') %}
              httpHeaders:
                - name: Authorization
                  value: "Basic {{ (dg_user | default('admin') ~ ':' ~ dg_password | default('changeit')) }}"
{% endif %}
            initialDelaySeconds: {{ readiness_initial_delay | default(15) }}
            periodSeconds: {{ readiness_period | default(10) }}
            timeoutSeconds: {{ readiness_timeout | default(5) }}
            failureThreshold: {{ readiness_failure_threshold | default(5) }}
          livenessProbe:
            httpGet:
              path: {{ liveness_path | default('/rest/v2/cache-managers/default/health/status') }}
              port: 11222
            initialDelaySeconds: {{ liveness_initial_delay | default(30) }}
            periodSeconds: {{ liveness_period | default(15) }}
            timeoutSeconds: {{ liveness_timeout | default(5) }}
            failureThreshold: {{ liveness_failure_threshold | default(5) }}
          volumeMounts:
            - name: data
              mountPath: {{ data_mount_path | default('/opt/infinispan/server/data') }}
{% if config_volume_enabled | default(false) %}
            - name: config-volume
              mountPath: {{ config_mount_path | default('/opt/infinispan/server/conf/infinispan.xml') }}
              subPath: infinispan.xml
{% endif %}
{% for mount in extra_volume_mounts | default([]) %}
            - name: {{ mount.name }}
              mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
              subPath: {{ mount.subPath }}
{% endif %}
{% endfor %}
{% if config_volume_enabled | default(false) or extra_volumes | default([]) %}
      volumes:
{% if config_volume_enabled | default(false) %}
        - name: config-volume
          configMap:
            name: {{ configmap_name | default('datagrid-config') }}
{% endif %}
{% for vol in extra_volumes | default([]) %}
        - name: {{ vol.name }}
{% if vol.configMap is defined %}
          configMap:
            name: {{ vol.configMap.name }}
{% elif vol.secret is defined %}
          secret:
            secretName: {{ vol.secret.secretName }}
{% endif %}
{% endfor %}
{% endif %}
{% if image_pull_secrets | default([]) %}
      imagePullSecrets:
{% for secret in image_pull_secrets %}
        - name: {{ secret }}
{% endfor %}
{% endif %}
  volumeClaimTemplates:
    - metadata:
        name: data
      spec:
        accessModes:
          - {{ access_mode | default('ReadWriteOnce') }}
{% if storage_class | default('') %}
        storageClassName: {{ storage_class }}
{% endif %}
        resources:
          requests:
            storage: {{ storage_size | default('1Gi') }}
