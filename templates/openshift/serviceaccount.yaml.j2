# ServiceAccount for the reproducer workloads
# Generated by Red Hat Reproducer Agent
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ sa_name | default('reproducer-sa') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
{% if sa_annotations | default({}) %}
  annotations:
{% for key, value in (sa_annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if image_pull_secrets | default([]) %}
imagePullSecrets:
{% for secret in image_pull_secrets %}
  - name: {{ secret }}
{% endfor %}
{% endif %}
{% if automount_token is defined %}
automountServiceAccountToken: {{ automount_token }}
{% endif %}
