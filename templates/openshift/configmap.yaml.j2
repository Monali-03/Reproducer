# ConfigMap for application / server configuration
# Generated by Red Hat Reproducer Agent
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ configmap_name | default('reproducer-config') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
data:
{% if config_files | default({}) %}
{% for filename, content in (config_files | default({})).items() %}
  {{ filename }}: |
    {{ content | indent(4) }}
{% endfor %}
{% else %}
  # Default configuration entries
  application.properties: |
    # Application properties for reproducer
    # Add your configuration here
    quarkus.http.port={{ container_port | default(8080) }}

  standalone.xml: |
    <!-- Placeholder: replace with actual standalone.xml content -->
    <!-- or mount via a separate ConfigMap if the file is large  -->
{% endif %}
{% if extra_data | default({}) %}
{% for key, value in (extra_data | default({})).items() %}
  {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
