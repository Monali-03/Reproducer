# PersistentVolumeClaim for reproducer data
# Generated by Red Hat Reproducer Agent
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: {{ pvc_name | default('reproducer-data') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
{% if pvc_annotations | default({}) %}
  annotations:
{% for key, value in (pvc_annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
  accessModes:
    - {{ access_mode | default('ReadWriteOnce') }}
{% if storage_class | default('') %}
  storageClassName: {{ storage_class }}
{% endif %}
{% if volume_mode | default('') %}
  volumeMode: {{ volume_mode }}
{% endif %}
  resources:
    requests:
      storage: {{ storage_size | default('1Gi') }}
{% if selector_labels | default({}) %}
  selector:
    matchLabels:
{% for key, value in (selector_labels | default({})).items() %}
      {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
