# Service for application / Data Grid
# Generated by Red Hat Reproducer Agent
apiVersion: v1
kind: Service
metadata:
  name: {{ service_name | default('reproducer-svc') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
{% if service_annotations | default({}) %}
  annotations:
{% for key, value in (service_annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
  type: {{ service_type | default('ClusterIP') }}
{% if service_type | default('ClusterIP') == 'ClusterIP' and headless | default(false) %}
  clusterIP: None
{% endif %}
  selector:
    app: {{ app_label | default('reproducer') }}
  ports:
    - name: {{ port_name | default('http') }}
      port: {{ service_port | default(8080) }}
      targetPort: {{ target_port | default(service_port | default(8080)) }}
      protocol: TCP
{% if service_type | default('ClusterIP') == 'NodePort' and node_port | default('') %}
      nodePort: {{ node_port }}
{% endif %}
{% for port in additional_ports | default([]) %}
    - name: {{ port.name }}
      port: {{ port.port }}
      targetPort: {{ port.targetPort | default(port.port) }}
      protocol: {{ port.protocol | default('TCP') }}
{% endfor %}
{% if session_affinity | default('') %}
  sessionAffinity: {{ session_affinity }}
{% if session_affinity == 'ClientIP' %}
  sessionAffinityConfig:
    clientIP:
      timeoutSeconds: {{ session_affinity_timeout | default(10800) }}
{% endif %}
{% endif %}
