# Route to expose the application externally
# Generated by Red Hat Reproducer Agent
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: {{ route_name | default('reproducer-route') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
{% if route_annotations | default({}) %}
  annotations:
{% for key, value in (route_annotations | default({})).items() %}
    {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
spec:
{% if route_host | default('') %}
  host: {{ route_host }}
{% endif %}
{% if route_path | default('') %}
  path: {{ route_path }}
{% endif %}
  to:
    kind: Service
    name: {{ service_name | default('reproducer-svc') }}
    weight: {{ route_weight | default(100) }}
  port:
    targetPort: {{ target_port | default(8080) }}
{% if tls_termination | default('edge') != 'none' %}
  tls:
    termination: {{ tls_termination | default('edge') }}
{% if tls_termination | default('edge') == 'reencrypt' %}
    destinationCACertificate: |-
      {{ destination_ca_cert | default('') | indent(6) }}
{% endif %}
    insecureEdgeTerminationPolicy: {{ insecure_policy | default('Redirect') }}
{% if tls_certificate | default('') %}
    certificate: |-
      {{ tls_certificate | indent(6) }}
{% endif %}
{% if tls_key | default('') %}
    key: |-
      {{ tls_key | indent(6) }}
{% endif %}
{% if tls_ca_certificate | default('') %}
    caCertificate: |-
      {{ tls_ca_certificate | indent(6) }}
{% endif %}
{% endif %}
  wildcardPolicy: {{ wildcard_policy | default('None') }}
