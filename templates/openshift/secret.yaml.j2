# Secret for sensitive configuration
# Generated by Red Hat Reproducer Agent
#
# WARNING: Replace all PLACEHOLDER values with real base64-encoded secrets
#          before applying this resource.
#
# To encode a value:   echo -n 'myvalue' | base64
# To decode a value:   echo 'bXl2YWx1ZQ==' | base64 -d
#
apiVersion: v1
kind: Secret
metadata:
  name: {{ secret_name | default('reproducer-secret') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
type: {{ secret_type | default('Opaque') }}
data:
{% if secret_data | default({}) %}
{% for key, value in (secret_data | default({})).items() %}
  {{ key }}: {{ value }}  # PLACEHOLDER - replace with real base64-encoded value
{% endfor %}
{% else %}
  # PLACEHOLDER entries - replace with actual base64-encoded values
  username: PLACEHOLDER_BASE64_USERNAME  # echo -n 'admin' | base64 -> YWRtaW4=
  password: PLACEHOLDER_BASE64_PASSWORD  # echo -n 'changeit' | base64 -> Y2hhbmdlaXQ=
{% if db_password_enabled | default(false) %}
  db-password: PLACEHOLDER_BASE64_DB_PASSWORD
{% endif %}
{% if keystore_password_enabled | default(false) %}
  keystore-password: PLACEHOLDER_BASE64_KEYSTORE_PASSWORD
{% endif %}
{% endif %}
{% if string_data | default({}) %}
stringData:
{% for key, value in (string_data | default({})).items() %}
  {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
