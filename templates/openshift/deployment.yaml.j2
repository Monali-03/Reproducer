# Deployment for EAP / application workload
# Generated by Red Hat Reproducer Agent
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ deployment_name | default('reproducer-app') }}
  namespace: {{ namespace | default('reproducer') }}
  labels:
    app: {{ app_label | default('reproducer') }}
    version: {{ app_version | default('1.0') }}
spec:
  replicas: {{ replicas | default(1) }}
  selector:
    matchLabels:
      app: {{ app_label | default('reproducer') }}
  strategy:
    type: {{ strategy_type | default('RollingUpdate') }}
{% if strategy_type | default('RollingUpdate') == 'RollingUpdate' %}
    rollingUpdate:
      maxSurge: {{ max_surge | default('25%') }}
      maxUnavailable: {{ max_unavailable | default('25%') }}
{% endif %}
  template:
    metadata:
      labels:
        app: {{ app_label | default('reproducer') }}
        version: {{ app_version | default('1.0') }}
{% if pod_annotations | default({}) %}
      annotations:
{% for key, value in (pod_annotations | default({})).items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
    spec:
{% if sa_name | default('') %}
      serviceAccountName: {{ sa_name }}
{% endif %}
      containers:
        - name: {{ container_name | default('app') }}
          image: {{ image | default('registry.redhat.io/jboss-eap-8/eap8-openjdk17-builder-openshift-rhel8:latest') }}
          imagePullPolicy: {{ image_pull_policy | default('IfNotPresent') }}
          ports:
            - name: http
              containerPort: {{ container_port | default(8080) }}
              protocol: TCP
{% if management_port | default('') %}
            - name: management
              containerPort: {{ management_port }}
              protocol: TCP
{% endif %}
{% if jgroups_port | default('') %}
            - name: ping
              containerPort: {{ jgroups_port }}
              protocol: TCP
{% endif %}
          env:
{% for env in env_vars | default([]) %}
            - name: {{ env.name }}
{% if env.value is defined %}
              value: "{{ env.value }}"
{% elif env.valueFrom is defined %}
              valueFrom:
{% if env.valueFrom.secretKeyRef is defined %}
                secretKeyRef:
                  name: {{ env.valueFrom.secretKeyRef.name }}
                  key: {{ env.valueFrom.secretKeyRef.key }}
{% elif env.valueFrom.configMapKeyRef is defined %}
                configMapKeyRef:
                  name: {{ env.valueFrom.configMapKeyRef.name }}
                  key: {{ env.valueFrom.configMapKeyRef.key }}
{% endif %}
{% endif %}
{% endfor %}
{% if java_opts | default('') %}
            - name: JAVA_OPTS_APPEND
              value: "{{ java_opts }}"
{% endif %}
{% if jgroups_cluster_password | default('') %}
            - name: JGROUPS_CLUSTER_PASSWORD
              value: "{{ jgroups_cluster_password }}"
{% endif %}
          resources:
            requests:
              cpu: {{ cpu_request | default('500m') }}
              memory: {{ memory_request | default('512Mi') }}
            limits:
              cpu: {{ cpu_limit | default('1000m') }}
              memory: {{ memory_limit | default('1Gi') }}
          readinessProbe:
            httpGet:
              path: {{ readiness_path | default('/health/ready') }}
              port: {{ health_port | default(container_port | default(8080)) }}
            initialDelaySeconds: {{ readiness_initial_delay | default(10) }}
            periodSeconds: {{ readiness_period | default(10) }}
            timeoutSeconds: {{ readiness_timeout | default(3) }}
            failureThreshold: {{ readiness_failure_threshold | default(3) }}
          livenessProbe:
            httpGet:
              path: {{ liveness_path | default('/health/live') }}
              port: {{ health_port | default(container_port | default(8080)) }}
            initialDelaySeconds: {{ liveness_initial_delay | default(30) }}
            periodSeconds: {{ liveness_period | default(15) }}
            timeoutSeconds: {{ liveness_timeout | default(3) }}
            failureThreshold: {{ liveness_failure_threshold | default(5) }}
{% if startup_probe_enabled | default(false) %}
          startupProbe:
            httpGet:
              path: {{ liveness_path | default('/health/live') }}
              port: {{ health_port | default(container_port | default(8080)) }}
            initialDelaySeconds: {{ startup_initial_delay | default(5) }}
            periodSeconds: {{ startup_period | default(5) }}
            failureThreshold: {{ startup_failure_threshold | default(30) }}
{% endif %}
{% if config_volume_enabled | default(true) %}
          volumeMounts:
            - name: config-volume
              mountPath: {{ config_mount_path | default('/opt/eap/standalone/configuration/standalone-openshift.xml') }}
              subPath: {{ config_subpath | default('standalone-openshift.xml') }}
{% endif %}
{% for mount in extra_volume_mounts | default([]) %}
            - name: {{ mount.name }}
              mountPath: {{ mount.mountPath }}
{% if mount.subPath is defined %}
              subPath: {{ mount.subPath }}
{% endif %}
{% if mount.readOnly | default(false) %}
              readOnly: true
{% endif %}
{% endfor %}
{% if config_volume_enabled | default(true) or extra_volumes | default([]) %}
      volumes:
{% if config_volume_enabled | default(true) %}
        - name: config-volume
          configMap:
            name: {{ configmap_name | default('reproducer-config') }}
{% endif %}
{% for vol in extra_volumes | default([]) %}
        - name: {{ vol.name }}
{% if vol.configMap is defined %}
          configMap:
            name: {{ vol.configMap.name }}
{% elif vol.secret is defined %}
          secret:
            secretName: {{ vol.secret.secretName }}
{% elif vol.persistentVolumeClaim is defined %}
          persistentVolumeClaim:
            claimName: {{ vol.persistentVolumeClaim.claimName }}
{% elif vol.emptyDir is defined %}
          emptyDir: {}
{% endif %}
{% endfor %}
{% endif %}
{% if image_pull_secrets | default([]) %}
      imagePullSecrets:
{% for secret in image_pull_secrets %}
        - name: {{ secret }}
{% endfor %}
{% endif %}
{% if node_selector | default({}) %}
      nodeSelector:
{% for key, value in (node_selector | default({})).items() %}
        {{ key }}: "{{ value }}"
{% endfor %}
{% endif %}
{% if tolerations | default([]) %}
      tolerations:
{% for toleration in tolerations %}
        - key: "{{ toleration.key }}"
          operator: "{{ toleration.operator | default('Equal') }}"
          value: "{{ toleration.value | default('') }}"
          effect: "{{ toleration.effect | default('NoSchedule') }}"
{% endfor %}
{% endif %}
