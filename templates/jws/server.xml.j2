<?xml version="1.0" encoding="UTF-8"?>
<!--
  JBoss Web Server / Apache Tomcat - server.xml
  Generated by Red Hat Reproducer Agent
-->
<Server port="{{ shutdown_port | default('8005') }}" shutdown="SHUTDOWN">

  <!-- Security listener to prevent the use of certain configuration attributes -->
  <Listener className="org.apache.catalina.security.SecurityListener"/>
  <!-- APR library loader -->
  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on"/>
  <!-- Prevent memory leaks due to use of particular Java/Jakarta EE APIs -->
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener"/>
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener"/>

  <!-- Global JNDI resources -->
  <GlobalNamingResources>
    <Resource name="UserDatabase" auth="Container"
              type="org.apache.catalina.UserDatabase"
              description="User database that can be updated and saved"
              factory="org.apache.catalina.users.MemoryUserDatabaseFactory"
              pathname="conf/tomcat-users.xml"/>
  </GlobalNamingResources>

  <Service name="Catalina">

    <!-- ============================================================ -->
    <!-- Thread Pool (Executor)                                       -->
    <!-- ============================================================ -->
    <Executor name="tomcatThreadPool"
              namePrefix="catalina-exec-"
              maxThreads="{{ max_threads | default('200') }}"
              minSpareThreads="{{ min_spare_threads | default('25') }}"
              maxQueueSize="{{ max_queue_size | default('100') }}"/>

    <!-- ============================================================ -->
    <!-- HTTP/1.1 Connector                                           -->
    <!-- ============================================================ -->
    <Connector port="{{ http_port | default('8080') }}"
               protocol="HTTP/1.1"
               executor="tomcatThreadPool"
               connectionTimeout="{{ connection_timeout | default('20000') }}"
               redirectPort="{{ https_port | default('8443') }}"
               maxParameterCount="{{ max_parameter_count | default('1000') }}"
               URIEncoding="UTF-8"
               acceptCount="{{ accept_count | default('100') }}"
               maxHttpHeaderSize="{{ max_http_header_size | default('8192') }}"
               compression="{{ compression | default('off') }}"
{% if compression | default('off') == 'on' %}
               compressionMinSize="{{ compression_min_size | default('2048') }}"
               compressibleMimeType="text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json"
{% endif %}
               server="{{ server_header | default('') }}"/>

{% if https_enabled | default(false) %}
    <!-- ============================================================ -->
    <!-- HTTPS Connector (SSL/TLS)                                    -->
    <!-- ============================================================ -->
    <Connector port="{{ https_port | default('8443') }}"
               protocol="org.apache.coyote.http11.Http11NioProtocol"
               executor="tomcatThreadPool"
               SSLEnabled="true"
               maxParameterCount="{{ max_parameter_count | default('1000') }}"
               scheme="https"
               secure="true">
        <SSLHostConfig protocols="{{ tls_protocols | default('TLSv1.2+TLSv1.3') }}"
                       ciphers="{{ tls_ciphers | default('TLS_AES_256_GCM_SHA384:TLS_AES_128_GCM_SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256') }}">
            <Certificate certificateKeystoreFile="{{ keystore_file | default('conf/localhost.jks') }}"
                         certificateKeystorePassword="{{ keystore_password | default('changeit') }}"
                         certificateKeystoreType="{{ keystore_type | default('JKS') }}"
                         type="RSA"/>
        </SSLHostConfig>
    </Connector>
{% else %}
    <!-- HTTPS Connector - uncomment and configure to enable SSL/TLS
    <Connector port="{{ https_port | default('8443') }}"
               protocol="org.apache.coyote.http11.Http11NioProtocol"
               executor="tomcatThreadPool"
               SSLEnabled="true"
               maxParameterCount="1000"
               scheme="https"
               secure="true">
        <SSLHostConfig protocols="TLSv1.2+TLSv1.3">
            <Certificate certificateKeystoreFile="conf/localhost.jks"
                         certificateKeystorePassword="changeit"
                         certificateKeystoreType="JKS"
                         type="RSA"/>
        </SSLHostConfig>
    </Connector>
    -->
{% endif %}

{% if ajp_enabled | default(false) %}
    <!-- ============================================================ -->
    <!-- AJP Connector                                                -->
    <!-- ============================================================ -->
    <Connector port="{{ ajp_port | default('8009') }}"
               protocol="AJP/1.3"
               redirectPort="{{ https_port | default('8443') }}"
               secretRequired="{{ ajp_secret_required | default('true') }}"
               secret="{{ ajp_secret | default('changeit') }}"
               address="{{ ajp_address | default('127.0.0.1') }}"/>
{% else %}
    <!-- AJP Connector - uncomment and configure if needed
    <Connector port="{{ ajp_port | default('8009') }}"
               protocol="AJP/1.3"
               redirectPort="{{ https_port | default('8443') }}"
               secretRequired="true"
               secret="changeit"
               address="127.0.0.1"/>
    -->
{% endif %}

    <!-- ============================================================ -->
    <!-- Engine                                                       -->
    <!-- ============================================================ -->
    <Engine name="Catalina" defaultHost="localhost"
{% if jvm_route | default('') %}
            jvmRoute="{{ jvm_route }}"
{% endif %}
    >

      <Realm className="org.apache.catalina.realm.LockOutRealm">
        <Realm className="org.apache.catalina.realm.UserDatabaseRealm"
               resourceName="UserDatabase"/>
      </Realm>

      <Host name="localhost"
            appBase="webapps"
            unpackWARs="true"
            autoDeploy="{{ auto_deploy | default('true') }}">

{% if context_path | default('/') != '/' %}
        <Context path="{{ context_path }}" docBase="{{ doc_base | default('ROOT') }}"/>
{% endif %}

        <!-- ======================================================== -->
        <!-- Access Log Valve                                         -->
        <!-- ======================================================== -->
        <Valve className="org.apache.catalina.valves.AccessLogValve"
               directory="logs"
               prefix="{{ access_log_prefix | default('localhost_access_log') }}"
               suffix=".txt"
               pattern="{{ access_log_pattern | default('%h %l %u %t &quot;%r&quot; %s %b %D') }}"
               rotatable="true"
               fileDateFormat=".yyyy-MM-dd"/>

{% if remote_ip_valve | default(false) %}
        <!-- Remote IP Valve for proxy/load balancer support -->
        <Valve className="org.apache.catalina.valves.RemoteIpValve"
               remoteIpHeader="X-Forwarded-For"
               protocolHeader="X-Forwarded-Proto"
               internalProxies="{{ internal_proxies | default('10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[0-1])\\.\\d{1,3}\\.\\d{1,3}') }}"/>
{% endif %}

{% if sticky_session | default(false) %}
        <!-- Session persistence for clustering -->
        <Valve className="org.apache.catalina.ha.session.JvmRouteBinderValve"/>
{% endif %}

      </Host>
    </Engine>
  </Service>
</Server>
