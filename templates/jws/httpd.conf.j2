#     SSLHonorCipherOrder on
#
#     SSLCertificateFile {{ ssl_cert_file | default('/etc/pki/tls/certs/localhost.crt') }}
#     SSLCertificateKeyFile {{ ssl_key_file | default('/etc/pki/tls/private/localhost.key') }}
#     # SSLCertificateChainFile {{ ssl_chain_file | default('/etc/pki/tls/certs/server-chain.crt') }}
#
#     # Forward to the same balancer / backend
#     ProxyPass {{ proxy_path | default('/') }} "balancer://{{ balancer_name | default('backend-cluster') }}{{ proxy_path | default('/') }}"
