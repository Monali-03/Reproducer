#     # HSTS header
#     Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
# </VirtualHost>

# =====================================================================
# Server Status (restrict access in production)
# =====================================================================
<Location "/server-status">
    SetHandler server-status
    Require ip {{ status_allow | default('127.0.0.1 ::1') }}
</Location>

# =====================================================================
# Security Headers
# =====================================================================
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "{{ x_frame_options | default('SAMEORIGIN') }}"
{% if referrer_policy | default('') %}
Header always set Referrer-Policy "{{ referrer_policy }}"
{% endif %}

# Hide server version
ServerTokens {{ server_tokens | default('Prod') }}
ServerSignature {{ server_signature | default('Off') }}
