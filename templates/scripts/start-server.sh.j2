#!/bin/bash
# ==============================================================================
# Start Server Script (EAP / Data Grid)
# Generated by Red Hat Reproducer Agent
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ==============================================================================
# Configuration
# ==============================================================================
SERVER_HOME="{{ server_home | default('${SERVER_HOME:-/opt/jboss/eap}') }}"
SERVER_CONFIG="{{ server_config | default('standalone-ha.xml') }}"
BIND_ADDRESS="{{ bind_address | default('0.0.0.0') }}"
PORT_OFFSET="{{ port_offset | default('0') }}"
NODE_NAME="{{ node_name | default('node1') }}"
JVM_OPTS="{{ jvm_opts | default('-Xms512m -Xmx1024m') }}"
RUN_IN_BACKGROUND="{{ run_in_background | default('true') }}"
PID_FILE="{{ pid_file | default('${SCRIPT_DIR}/server.pid') }}"
LOG_DIR="{{ log_dir | default('${SCRIPT_DIR}/../logs') }}"

# Additional JVM options
{% if gc_options | default('') %}
JVM_OPTS="${JVM_OPTS} {{ gc_options }}"
{% endif %}
{% if debug_enabled | default(false) %}
JVM_OPTS="${JVM_OPTS} -agentlib:jdwp=transport=dt_socket,address={{ debug_port | default('8787') }},server=y,suspend={{ debug_suspend | default('n') }}"
{% endif %}
{% if jfr_enabled | default(false) %}
JVM_OPTS="${JVM_OPTS} -XX:StartFlightRecording=filename=${LOG_DIR}/recording-${NODE_NAME}.jfr,duration={{ jfr_duration | default('60s') }},settings={{ jfr_settings | default('profile') }}"
{% endif %}
{% if extra_jvm_opts | default('') %}
JVM_OPTS="${JVM_OPTS} {{ extra_jvm_opts }}"
{% endif %}

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# ==============================================================================
# Validation
# ==============================================================================
validate() {
    if [[ ! -d "${SERVER_HOME}" ]]; then
        log "${RED}[ERROR]${NC} SERVER_HOME does not exist: ${SERVER_HOME}"
        exit 1
    fi

{% if server_type | default('eap') == 'eap' %}
    local start_script="${SERVER_HOME}/bin/standalone.sh"
{% elif server_type | default('eap') == 'datagrid' %}
    local start_script="${SERVER_HOME}/bin/server.sh"
{% endif %}

    if [[ ! -x "${start_script}" ]]; then
        log "${RED}[ERROR]${NC} Start script not found or not executable: ${start_script}"
        exit 1
    fi

    # Check if a server is already running
    if [[ -f "${PID_FILE}" ]]; then
        local existing_pid
        existing_pid=$(cat "${PID_FILE}")
        if kill -0 "${existing_pid}" 2>/dev/null; then
            log "${YELLOW}[WARN]${NC} Server already running with PID ${existing_pid}"
            log "Stop the existing server first, or remove ${PID_FILE}"
            exit 1
        else
            log "${YELLOW}[WARN]${NC} Stale PID file found, removing"
            rm -f "${PID_FILE}"
        fi
    fi
}

# ==============================================================================
# Start the Server
# ==============================================================================
start_server() {
    mkdir -p "${LOG_DIR}"

    log "${GREEN}Starting server...${NC}"
    log "  Server Home:  ${SERVER_HOME}"
    log "  Config:       ${SERVER_CONFIG}"
    log "  Bind Address: ${BIND_ADDRESS}"
    log "  Port Offset:  ${PORT_OFFSET}"
    log "  Node Name:    ${NODE_NAME}"
    log "  JVM Options:  ${JVM_OPTS}"

{% if server_type | default('eap') == 'eap' %}
    # ---- JBoss EAP / WildFly ----
    local cmd="${SERVER_HOME}/bin/standalone.sh"
    local args=(
        -c "${SERVER_CONFIG}"
        -b "${BIND_ADDRESS}"
        -bmanagement "${BIND_ADDRESS}"
        -Djboss.socket.binding.port-offset="${PORT_OFFSET}"
        -Djboss.node.name="${NODE_NAME}"
{% if multicast_address | default('') %}
        -u "{{ multicast_address }}"
{% endif %}
{% for prop in system_properties | default([]) %}
        -D{{ prop.name }}={{ prop.value }}
{% endfor %}
    )
{% elif server_type | default('eap') == 'datagrid' %}
    # ---- Data Grid / Infinispan Server ----
    local cmd="${SERVER_HOME}/bin/server.sh"
    local args=(
        -c "${SERVER_CONFIG}"
        -b "${BIND_ADDRESS}"
        -o "${PORT_OFFSET}"
        -Dinfinispan.node.name="${NODE_NAME}"
{% for prop in system_properties | default([]) %}
        -D{{ prop.name }}={{ prop.value }}
{% endfor %}
    )
{% endif %}

    export JAVA_OPTS="${JVM_OPTS}"

    if [[ "${RUN_IN_BACKGROUND}" == "true" ]]; then
        local log_file="${LOG_DIR}/server-${NODE_NAME}.log"
        log "Running in background, output to: ${log_file}"

        nohup "${cmd}" "${args[@]}" > "${log_file}" 2>&1 &
        local server_pid=$!
        echo "${server_pid}" > "${PID_FILE}"
        log "${GREEN}[OK]${NC} Server started with PID ${server_pid}"

        # Wait briefly and verify server is still running
        sleep 3
        if kill -0 "${server_pid}" 2>/dev/null; then
            log "${GREEN}[OK]${NC} Server process is alive"
        else
            log "${RED}[ERROR]${NC} Server process died shortly after start"
            log "Check ${log_file} for details"
            exit 1
        fi

{% if wait_for_ready | default(true) %}
        # Wait for the server to become ready
        local health_url="http://${BIND_ADDRESS}:$(( {{ health_port | default('9990') }} + ${PORT_OFFSET} )){{ health_path | default('/health/ready') }}"
        local max_wait={{ startup_timeout | default('120') }}
        local waited=0

        log "Waiting for server to become ready (timeout: ${max_wait}s)..."
        while [[ ${waited} -lt ${max_wait} ]]; do
            if curl -sf "${health_url}" > /dev/null 2>&1; then
                log "${GREEN}[OK]${NC} Server is ready (waited ${waited}s)"
                return 0
            fi
            sleep 2
            waited=$((waited + 2))
        done

        log "${YELLOW}[WARN]${NC} Server did not become ready within ${max_wait}s"
        log "The server may still be starting. Check logs at: ${log_file}"
{% endif %}
    else
        log "Running in foreground (Ctrl+C to stop)..."
        exec "${cmd}" "${args[@]}"
    fi
}

# ==============================================================================
# Main
# ==============================================================================
validate
start_server
