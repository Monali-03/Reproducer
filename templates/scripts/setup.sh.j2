#!/bin/bash
# ==============================================================================
# Setup Script for Reproducer Environment
# Generated by Red Hat Reproducer Agent
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="${SCRIPT_DIR}/setup.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $1"
    echo -e "${msg}" | tee -a "${LOG_FILE}"
}

log_ok()   { log "${GREEN}[OK]${NC} $1"; }
log_warn() { log "${YELLOW}[WARN]${NC} $1"; }
log_err()  { log "${RED}[ERROR]${NC} $1"; }

# ==============================================================================
# Check Prerequisites
# ==============================================================================
check_prerequisites() {
    log "Checking prerequisites..."
    local missing=0

{% for tool in required_tools | default(['java', 'mvn']) %}
    if command -v {{ tool }} &>/dev/null; then
        log_ok "{{ tool }} found: $({{ tool }} --version 2>&1 | head -1)"
    else
        log_err "{{ tool }} is not installed or not in PATH"
        missing=$((missing + 1))
    fi
{% endfor %}

    # Check Java version if java is available
    if command -v java &>/dev/null; then
        local java_version
        java_version=$(java -version 2>&1 | head -1 | awk -F '"' '{print $2}')
        local java_major
        java_major=$(echo "${java_version}" | cut -d'.' -f1)
        if [[ "${java_major}" -lt {{ min_java_version | default('17') }} ]]; then
            log_err "Java ${java_version} found, but Java {{ min_java_version | default('17') }}+ is required"
            missing=$((missing + 1))
        fi
    fi

{% if check_docker | default(false) %}
    # Check container runtime
    if command -v podman &>/dev/null; then
        log_ok "podman found: $(podman --version)"
    elif command -v docker &>/dev/null; then
        log_ok "docker found: $(docker --version)"
    else
        log_warn "No container runtime (podman/docker) found"
    fi
{% endif %}

{% if check_oc | default(false) %}
    # Check OpenShift CLI
    if command -v oc &>/dev/null; then
        log_ok "oc found: $(oc version --client 2>/dev/null | head -1)"
    else
        log_warn "oc (OpenShift CLI) not found - OpenShift deployments will not be available"
    fi
{% endif %}

    if [[ ${missing} -gt 0 ]]; then
        log_err "${missing} required tool(s) missing. Please install them and retry."
        exit 1
    fi

    log_ok "All prerequisites satisfied"
}

# ==============================================================================
# Set Environment Variables
# ==============================================================================
setup_environment() {
    log "Setting up environment variables..."

{% if server_home | default('') %}
    export SERVER_HOME="{{ server_home }}"
    log "SERVER_HOME=${SERVER_HOME}"
{% endif %}

{% if java_home | default('') %}
    export JAVA_HOME="{{ java_home }}"
    export PATH="${JAVA_HOME}/bin:${PATH}"
    log "JAVA_HOME=${JAVA_HOME}"
{% endif %}

{% for env in env_vars | default([]) %}
    export {{ env.name }}="{{ env.value }}"
    log "{{ env.name }}={{ env.value }}"
{% endfor %}

    # Reproducer-specific variables
    export REPRODUCER_HOME="{{ reproducer_home | default('${SCRIPT_DIR}/..') }}"
    export REPRODUCER_LOGS="{{ reproducer_logs | default('${REPRODUCER_HOME}/logs') }}"

    mkdir -p "${REPRODUCER_LOGS}"
    log_ok "Environment configured"
}

# ==============================================================================
# Build Application (if applicable)
# ==============================================================================
build_application() {
{% if build_enabled | default(true) %}
    local app_dir="{{ app_dir | default('${REPRODUCER_HOME}/app') }}"

    if [[ -f "${app_dir}/pom.xml" ]]; then
        log "Building application with Maven..."
        pushd "${app_dir}" > /dev/null
        mvn clean package {{ maven_args | default('-DskipTests -q') }} 2>&1 | tee -a "${LOG_FILE}"
        local rc=${PIPESTATUS[0]}
        popd > /dev/null

        if [[ ${rc} -eq 0 ]]; then
            log_ok "Application built successfully"
        else
            log_err "Application build failed (exit code: ${rc})"
            exit 1
        fi
{% if deploy_artifact | default('') %}
        # Deploy artifact to server
        local artifact="${app_dir}/target/{{ deploy_artifact }}"
        local deploy_dir="{{ deploy_dir | default('${SERVER_HOME}/standalone/deployments') }}"
        if [[ -f "${artifact}" ]]; then
            cp "${artifact}" "${deploy_dir}/"
            log_ok "Deployed $(basename "${artifact}") to ${deploy_dir}"
        else
            log_err "Artifact not found: ${artifact}"
            exit 1
        fi
{% endif %}
    else
        log_warn "No pom.xml found in ${app_dir}, skipping build"
    fi
{% else %}
    log "Build step skipped (build_enabled=false)"
{% endif %}
}

# ==============================================================================
# Copy Configuration Files
# ==============================================================================
copy_configuration() {
    log "Copying configuration files..."

{% if server_home | default('') %}
    local config_src="{{ config_src | default('${REPRODUCER_HOME}/config') }}"
    local config_dst="{{ config_dst | default('${SERVER_HOME}/standalone/configuration') }}"

    if [[ -d "${config_src}" ]]; then
        cp -v "${config_src}"/* "${config_dst}/" 2>&1 | tee -a "${LOG_FILE}"
        log_ok "Configuration files copied"
    else
        log_warn "No configuration directory found at ${config_src}"
    fi
{% else %}
    log "No SERVER_HOME set, skipping configuration copy"
{% endif %}
}

# ==============================================================================
# Custom Setup Steps
# ==============================================================================
custom_setup() {
{% if custom_setup_steps | default('') %}
    log "Running custom setup steps..."
    {{ custom_setup_steps | indent(4) }}
    log_ok "Custom setup steps completed"
{% else %}
    log "No custom setup steps defined"
{% endif %}
}

# ==============================================================================
# Main
# ==============================================================================
main() {
    log "============================================"
    log "Reproducer Setup - Starting"
    log "============================================"

    check_prerequisites
    setup_environment
    build_application
    copy_configuration
    custom_setup

    log "============================================"
    log "Reproducer Setup - Complete"
    log "============================================"
}

main "$@"
