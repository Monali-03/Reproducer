#!/bin/bash
# ==============================================================================
# Log Collection Script
# Generated by Red Hat Reproducer Agent
#
# Gathers server logs, JVM info, thread dumps, and diagnostic data into a
# compressed archive for analysis.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TIMESTAMP=$(date '+%Y%m%d-%H%M%S')
COLLECT_DIR="{{ collect_dir | default('/tmp') }}/reproducer-logs-${TIMESTAMP}"
ARCHIVE_NAME="reproducer-logs-${TIMESTAMP}.tar.gz"

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

mkdir -p "${COLLECT_DIR}"

# ==============================================================================
# System and JVM Information
# ==============================================================================
collect_system_info() {
    log "Collecting system and JVM information..."
    local info_dir="${COLLECT_DIR}/system-info"
    mkdir -p "${info_dir}"

    # OS information
    {
        echo "=== Hostname ==="
        hostname -f 2>/dev/null || hostname
        echo ""
        echo "=== Date/Time ==="
        date
        echo ""
        echo "=== OS Release ==="
        cat /etc/os-release 2>/dev/null || echo "N/A"
        echo ""
        echo "=== Kernel ==="
        uname -a
        echo ""
        echo "=== CPU Info ==="
        lscpu 2>/dev/null || cat /proc/cpuinfo 2>/dev/null | head -30 || echo "N/A"
        echo ""
        echo "=== Memory ==="
        free -h 2>/dev/null || cat /proc/meminfo 2>/dev/null | head -10 || echo "N/A"
        echo ""
        echo "=== Disk Usage ==="
        df -h 2>/dev/null || echo "N/A"
        echo ""
        echo "=== Network Interfaces ==="
        ip addr 2>/dev/null || ifconfig 2>/dev/null || echo "N/A"
        echo ""
        echo "=== Listening Ports ==="
        ss -tlnp 2>/dev/null || netstat -tlnp 2>/dev/null || echo "N/A"
    } > "${info_dir}/system-info.txt" 2>&1

    # Java version
    if command -v java &>/dev/null; then
        java -version > "${info_dir}/java-version.txt" 2>&1
        log "${GREEN}[OK]${NC} Java version captured"
    else
        echo "Java not found in PATH" > "${info_dir}/java-version.txt"
        log "${YELLOW}[WARN]${NC} Java not found"
    fi

    # Environment variables (sanitize sensitive values)
    env | grep -iE '(java|jboss|eap|infinispan|wildfly|home|path|opts)' \
        | sed 's/\(PASSWORD\|SECRET\|TOKEN\|KEY\)=.*/\1=***REDACTED***/i' \
        > "${info_dir}/environment.txt" 2>/dev/null || true

    log "${GREEN}[OK]${NC} System info collected"
}

# ==============================================================================
# Server Logs
# ==============================================================================
collect_server_logs() {
    log "Collecting server logs..."
    local logs_dir="${COLLECT_DIR}/server-logs"
    mkdir -p "${logs_dir}"

{% if server_home | default('') %}
    local server_log_dir="{{ server_home }}/standalone/log"
    if [[ -d "${server_log_dir}" ]]; then
        cp -r "${server_log_dir}"/* "${logs_dir}/" 2>/dev/null || true
        log "${GREEN}[OK]${NC} Server logs copied from ${server_log_dir}"
    else
        log "${YELLOW}[WARN]${NC} Server log directory not found: ${server_log_dir}"
    fi
{% endif %}

    # Reproducer agent logs
    local reproducer_logs="{{ reproducer_logs | default('${SCRIPT_DIR}/../logs') }}"
    if [[ -d "${reproducer_logs}" ]]; then
        cp -r "${reproducer_logs}"/* "${logs_dir}/" 2>/dev/null || true
        log "${GREEN}[OK]${NC} Reproducer logs copied from ${reproducer_logs}"
    fi

{% for log_path in extra_log_paths | default([]) %}
    if [[ -e "{{ log_path }}" ]]; then
        cp -r "{{ log_path }}" "${logs_dir}/" 2>/dev/null || true
        log "${GREEN}[OK]${NC} Copied {{ log_path }}"
    fi
{% endfor %}
}

# ==============================================================================
# Thread Dump (if server is running)
# ==============================================================================
collect_thread_dump() {
    log "Attempting thread dump..."
    local dump_dir="${COLLECT_DIR}/thread-dumps"
    mkdir -p "${dump_dir}"

    # Find the server JVM process
    local server_pid=""

    # Try PID file first
    local pid_file="{{ pid_file | default('${SCRIPT_DIR}/server.pid') }}"
    if [[ -f "${pid_file}" ]]; then
        server_pid=$(cat "${pid_file}")
    fi

    # Fall back to finding Java process
    if [[ -z "${server_pid}" ]] || ! kill -0 "${server_pid}" 2>/dev/null; then
{% if server_home | default('') %}
        server_pid=$(pgrep -f "{{ server_home }}" 2>/dev/null | head -1 || true)
{% else %}
        server_pid=$(pgrep -f "jboss\|infinispan\|wildfly" 2>/dev/null | head -1 || true)
{% endif %}
    fi

    if [[ -n "${server_pid}" ]] && kill -0 "${server_pid}" 2>/dev/null; then
        log "Found server process: PID ${server_pid}"

        # Take {{ thread_dump_count | default('3') }} thread dumps with {{ thread_dump_interval | default('5') }}s interval
        for i in $(seq 1 {{ thread_dump_count | default('3') }}); do
            local dump_file="${dump_dir}/thread-dump-${i}.txt"
            log "  Taking thread dump ${i}/{{ thread_dump_count | default('3') }}..."

            # Try jcmd first (preferred), then jstack, then kill -3
            if command -v jcmd &>/dev/null; then
                jcmd "${server_pid}" Thread.print > "${dump_file}" 2>&1
            elif command -v jstack &>/dev/null; then
                jstack -l "${server_pid}" > "${dump_file}" 2>&1
            else
                kill -3 "${server_pid}" 2>/dev/null || true
                echo "Signal sent (SIGQUIT). Check server stdout/log for thread dump." > "${dump_file}"
            fi

            if [[ ${i} -lt {{ thread_dump_count | default('3') }} ]]; then
                sleep {{ thread_dump_interval | default('5') }}
            fi
        done

        # Heap info (non-destructive)
        if command -v jcmd &>/dev/null; then
            jcmd "${server_pid}" GC.heap_info > "${dump_dir}/heap-info.txt" 2>&1 || true
            jcmd "${server_pid}" VM.flags > "${dump_dir}/vm-flags.txt" 2>&1 || true
            jcmd "${server_pid}" VM.system_properties > "${dump_dir}/vm-system-properties.txt" 2>&1 || true
        fi

        log "${GREEN}[OK]${NC} Thread dumps collected"
    else
        log "${YELLOW}[WARN]${NC} No running server process found, skipping thread dump"
    fi
}

# ==============================================================================
# Server Configuration Snapshot
# ==============================================================================
collect_configuration() {
    log "Collecting server configuration..."
    local config_dir="${COLLECT_DIR}/configuration"
    mkdir -p "${config_dir}"

{% if server_home | default('') %}
    local server_config_dir="{{ server_home }}/standalone/configuration"
    if [[ -d "${server_config_dir}" ]]; then
        # Copy XML configs (exclude keystores and credentials)
        find "${server_config_dir}" -maxdepth 1 \( -name "*.xml" -o -name "*.properties" -o -name "*.conf" \) \
            -exec cp {} "${config_dir}/" \; 2>/dev/null || true
        log "${GREEN}[OK]${NC} Server configuration copied"
    fi
{% endif %}
}

# ==============================================================================
# Custom Diagnostics
# ==============================================================================
collect_custom_diagnostics() {
{% if custom_diagnostics | default('') %}
    log "Running custom diagnostics..."
    local custom_dir="${COLLECT_DIR}/custom"
    mkdir -p "${custom_dir}"
    {{ custom_diagnostics | indent(4) }}
    log "${GREEN}[OK]${NC} Custom diagnostics collected"
{% else %}
    log "No custom diagnostics defined"
{% endif %}
}

# ==============================================================================
# Create Archive
# ==============================================================================
create_archive() {
    local output_dir="{{ output_dir | default('${SCRIPT_DIR}/..') }}"
    local archive_path="${output_dir}/${ARCHIVE_NAME}"

    log "Creating archive: ${archive_path}"
    tar -czf "${archive_path}" -C "$(dirname "${COLLECT_DIR}")" "$(basename "${COLLECT_DIR}")"

    # Clean up the temporary collection directory
    rm -rf "${COLLECT_DIR}"

    local archive_size
    archive_size=$(du -h "${archive_path}" | awk '{print $1}')
    log "${GREEN}[OK]${NC} Archive created: ${archive_path} (${archive_size})"
    echo "${archive_path}"
}

# ==============================================================================
# Main
# ==============================================================================
main() {
    log "============================================"
    log "Log Collection - Starting"
    log "============================================"

    collect_system_info
    collect_server_logs
    collect_thread_dump
    collect_configuration
    collect_custom_diagnostics

    local archive
    archive=$(create_archive)

    log "============================================"
    log "Log Collection - Complete"
    log "Archive: ${archive}"
    log "============================================"
}

main "$@"
