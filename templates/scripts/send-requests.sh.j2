#!/bin/bash
# ==============================================================================
# Request Sender Script
# Generated by Red Hat Reproducer Agent
#
# Sends concurrent HTTP requests to the target URL and reports results.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="{{ log_dir | default('${SCRIPT_DIR}/../logs') }}"
RESULTS_FILE="${LOG_DIR}/request-results.csv"

# ==============================================================================
# Configuration
# ==============================================================================
TARGET_URL="{{ target_url | default('http://localhost:8080') }}"
NUM_REQUESTS="{{ num_requests | default('100') }}"
CONCURRENCY="{{ concurrency | default('10') }}"
REQUEST_METHOD="{{ request_method | default('GET') }}"
TIMEOUT="{{ request_timeout | default('30') }}"
{% if request_body | default('') %}
REQUEST_BODY='{{ request_body }}'
{% endif %}
{% if content_type | default('') %}
CONTENT_TYPE="{{ content_type }}"
{% endif %}
{% if auth_header | default('') %}
AUTH_HEADER="{{ auth_header }}"
{% endif %}
COOKIE_JAR="{{ cookie_jar_file | default('${LOG_DIR}/cookies.txt') }}"
USE_COOKIES="{{ use_cookies | default('true') }}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log() { echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

mkdir -p "${LOG_DIR}"

# ==============================================================================
# Build curl command
# ==============================================================================
build_curl_args() {
    local args=(
        -s
        -w '%{http_code}|%{time_total}|%{size_download}|%{url_effective}\n'
        -o /dev/null
        -X "${REQUEST_METHOD}"
        --max-time "${TIMEOUT}"
        --retry 0
    )

{% if content_type | default('') %}
    args+=(-H "Content-Type: ${CONTENT_TYPE}")
{% endif %}
{% if auth_header | default('') %}
    args+=(-H "Authorization: ${AUTH_HEADER}")
{% endif %}
{% for header in extra_headers | default([]) %}
    args+=(-H "{{ header }}")
{% endfor %}
{% if request_body | default('') %}
    args+=(-d "${REQUEST_BODY}")
{% endif %}

    if [[ "${USE_COOKIES}" == "true" ]]; then
        args+=(-b "${COOKIE_JAR}" -c "${COOKIE_JAR}")
    fi

{% if insecure | default(false) %}
    args+=(-k)
{% endif %}

    args+=("${TARGET_URL}")

    echo "${args[@]}"
}

# ==============================================================================
# Send a single request and write result to CSV
# ==============================================================================
send_single_request() {
    local request_id=$1
    local curl_args
    curl_args=$(build_curl_args)

    local result
    result=$(eval curl ${curl_args} 2>&1) || result="000|0.000|0|ERROR"

    local http_code response_time size url
    IFS='|' read -r http_code response_time size url <<< "${result}"

    # Write CSV row (thread-safe with flock)
    {
        flock -x 200
        echo "${request_id},${http_code},${response_time},${size}" >> "${RESULTS_FILE}"
    } 200>"${RESULTS_FILE}.lock"

    # Print progress
    if [[ "${http_code}" =~ ^2[0-9][0-9]$ ]]; then
        echo -e "  [${request_id}/${NUM_REQUESTS}] ${GREEN}${http_code}${NC} ${response_time}s"
    elif [[ "${http_code}" =~ ^[3-9][0-9][0-9]$ ]]; then
        echo -e "  [${request_id}/${NUM_REQUESTS}] ${YELLOW}${http_code}${NC} ${response_time}s"
    else
        echo -e "  [${request_id}/${NUM_REQUESTS}] ${RED}${http_code}${NC} ${response_time}s"
    fi
}

# ==============================================================================
# Run requests concurrently
# ==============================================================================
run_concurrent_requests() {
    log "${CYAN}Sending ${NUM_REQUESTS} requests with concurrency ${CONCURRENCY}${NC}"
    log "  Target:  ${TARGET_URL}"
    log "  Method:  ${REQUEST_METHOD}"
    log "  Timeout: ${TIMEOUT}s"

    # Initialize CSV
    echo "request_id,http_code,response_time,size_bytes" > "${RESULTS_FILE}"

    local start_time
    start_time=$(date +%s%N)

    # Use a FIFO-based semaphore for concurrency control
    local fifo="${LOG_DIR}/.request-fifo-$$"
    mkfifo "${fifo}"
    exec 3<>"${fifo}"
    rm -f "${fifo}"

    # Pre-fill the semaphore with concurrency tokens
    for _ in $(seq 1 "${CONCURRENCY}"); do
        echo >&3
    done

    # Launch requests
    for i in $(seq 1 "${NUM_REQUESTS}"); do
        # Wait for a token (blocks if all slots are in use)
        read -u 3

        (
            send_single_request "${i}"
            # Release the token
            echo >&3
        ) &

{% if delay_between_requests | default('') %}
        sleep {{ delay_between_requests }}
{% endif %}
    done

    # Wait for all background jobs to finish
    wait

    # Close the semaphore
    exec 3>&-

    local end_time
    end_time=$(date +%s%N)
    local elapsed_ms=$(( (end_time - start_time) / 1000000 ))

    echo "${elapsed_ms}" > "${LOG_DIR}/.elapsed_ms"
}

# ==============================================================================
# Generate Summary Report
# ==============================================================================
generate_report() {
    local elapsed_ms
    elapsed_ms=$(cat "${LOG_DIR}/.elapsed_ms" 2>/dev/null || echo "0")
    rm -f "${LOG_DIR}/.elapsed_ms"
    rm -f "${RESULTS_FILE}.lock"

    local elapsed_sec
    elapsed_sec=$(awk "BEGIN {printf \"%.2f\", ${elapsed_ms}/1000}")

    # Count results by HTTP status
    local total success_2xx redirect_3xx client_err_4xx server_err_5xx errors
    total=$(tail -n +2 "${RESULTS_FILE}" | wc -l)
    success_2xx=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$2 ~ /^2/' | wc -l)
    redirect_3xx=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$2 ~ /^3/' | wc -l)
    client_err_4xx=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$2 ~ /^4/' | wc -l)
    server_err_5xx=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$2 ~ /^5/' | wc -l)
    errors=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$2 ~ /^0/' | wc -l)

    # Response time stats
    local avg_time min_time max_time p95_time
    avg_time=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '{sum+=$3; n++} END {if(n>0) printf "%.3f", sum/n; else print "0"}')
    min_time=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' 'NR==1||$3<min {min=$3} END {printf "%.3f", min}')
    max_time=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '$3>max {max=$3} END {printf "%.3f", max}')
    p95_time=$(tail -n +2 "${RESULTS_FILE}" | awk -F',' '{print $3}' | sort -n | awk -v p=0.95 'BEGIN{c=0} {v[c++]=$1} END{printf "%.3f", v[int(c*p)]}')

    # Requests per second
    local rps
    rps=$(awk "BEGIN {if(${elapsed_sec}>0) printf \"%.1f\", ${total}/${elapsed_sec}; else print \"N/A\"}")

    log ""
    log "${CYAN}=====================================================${NC}"
    log "${CYAN} Request Summary${NC}"
    log "${CYAN}=====================================================${NC}"
    log ""
    log "  Target URL:     ${TARGET_URL}"
    log "  Total Requests: ${total}"
    log "  Concurrency:    ${CONCURRENCY}"
    log "  Total Time:     ${elapsed_sec}s"
    log "  Requests/sec:   ${rps}"
    log ""
    log "  ${GREEN}2xx Success:    ${success_2xx}${NC}"
    log "  ${YELLOW}3xx Redirect:   ${redirect_3xx}${NC}"
    log "  ${RED}4xx Client Err: ${client_err_4xx}${NC}"
    log "  ${RED}5xx Server Err: ${server_err_5xx}${NC}"
    log "  ${RED}Connection Err: ${errors}${NC}"
    log ""
    log "  Response Times:"
    log "    Min:  ${min_time}s"
    log "    Avg:  ${avg_time}s"
    log "    Max:  ${max_time}s"
    log "    p95:  ${p95_time}s"
    log ""
    log "  Results CSV: ${RESULTS_FILE}"
    log "${CYAN}=====================================================${NC}"
}

# ==============================================================================
# Main
# ==============================================================================
main() {
    run_concurrent_requests
    generate_report
}

main "$@"
