#!/bin/bash
# ==============================================================================
# Reproduction Script
# Generated by Red Hat Reproducer Agent
#
# This script executes the steps needed to reproduce a reported issue.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_DIR="{{ log_dir | default('${SCRIPT_DIR}/../logs') }}"
RESULT_FILE="${LOG_DIR}/reproduce-result.log"

# Configuration
TARGET_URL="{{ target_url | default('http://localhost:8080/reproducer-app/test') }}"
NUM_REQUESTS="{{ num_requests | default('10') }}"
CONCURRENCY="{{ concurrency | default('1') }}"
REQUEST_METHOD="{{ request_method | default('GET') }}"
{% if request_body | default('') %}
REQUEST_BODY='{{ request_body }}'
{% endif %}
{% if content_type | default('') %}
CONTENT_TYPE="{{ content_type }}"
{% endif %}
{% if auth_header | default('') %}
AUTH_HEADER="{{ auth_header }}"
{% endif %}

# Counters
SUCCESS_COUNT=0
FAILURE_COUNT=0
ERROR_COUNT=0

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "${RESULT_FILE}"; }

mkdir -p "${LOG_DIR}"

# ==============================================================================
# Pre-Steps
# ==============================================================================
pre_steps() {
{% if pre_steps | default('') %}
    log "Running pre-reproduction steps..."
    {{ pre_steps | indent(4) }}
    log "${GREEN}[OK]${NC} Pre-steps completed"
{% else %}
    log "No pre-steps defined"
{% endif %}
}

# ==============================================================================
# Wait for Server
# ==============================================================================
wait_for_server() {
    local url="{{ health_check_url | default(target_url | default('http://localhost:8080')) }}"
    local max_wait={{ server_wait_timeout | default('60') }}
    local waited=0

    log "Waiting for server at ${url} ..."
    while [[ ${waited} -lt ${max_wait} ]]; do
        if curl -sf -o /dev/null "${url}" 2>/dev/null; then
            log "${GREEN}[OK]${NC} Server is reachable"
            return 0
        fi
        sleep 2
        waited=$((waited + 2))
    done

    log "${RED}[ERROR]${NC} Server not reachable after ${max_wait}s"
    exit 1
}

# ==============================================================================
# Send Requests
# ==============================================================================
send_request() {
    local request_num=$1
    local curl_args=(
        -s
        -o /dev/null
        -w "%{http_code} %{time_total}"
        -X "${REQUEST_METHOD}"
        --max-time {{ request_timeout | default('30') }}
    )

{% if content_type | default('') %}
    curl_args+=(-H "Content-Type: ${CONTENT_TYPE}")
{% endif %}
{% if auth_header | default('') %}
    curl_args+=(-H "Authorization: ${AUTH_HEADER}")
{% endif %}
{% if request_body | default('') %}
    curl_args+=(-d "${REQUEST_BODY}")
{% endif %}
{% if cookie_jar | default(false) %}
    curl_args+=(-b "${LOG_DIR}/cookies.txt" -c "${LOG_DIR}/cookies.txt")
{% endif %}
{% for header in extra_headers | default([]) %}
    curl_args+=(-H "{{ header }}")
{% endfor %}

    curl_args+=("${TARGET_URL}")

    local result
    result=$(curl "${curl_args[@]}" 2>&1) || true

    local http_code
    local response_time
    http_code=$(echo "${result}" | awk '{print $1}')
    response_time=$(echo "${result}" | awk '{print $2}')

    if [[ "${http_code}" =~ ^2[0-9][0-9]$ ]]; then
        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))
        log "  Request #${request_num}: ${GREEN}${http_code}${NC} (${response_time}s)"
    elif [[ "${http_code}" =~ ^[0-9]+$ ]]; then
        FAILURE_COUNT=$((FAILURE_COUNT + 1))
        log "  Request #${request_num}: ${RED}${http_code}${NC} (${response_time}s)"
    else
        ERROR_COUNT=$((ERROR_COUNT + 1))
        log "  Request #${request_num}: ${RED}ERROR${NC} - ${result}"
    fi
}

run_requests() {
    log "============================================"
    log "Sending ${NUM_REQUESTS} requests to ${TARGET_URL}"
    log "  Method:      ${REQUEST_METHOD}"
    log "  Concurrency: ${CONCURRENCY}"
    log "============================================"

    if [[ "${CONCURRENCY}" -le 1 ]]; then
        # Sequential execution
        for i in $(seq 1 "${NUM_REQUESTS}"); do
            send_request "${i}"
{% if delay_between_requests | default('') %}
            sleep {{ delay_between_requests }}
{% endif %}
        done
    else
        # Concurrent execution using background processes
        local running=0
        for i in $(seq 1 "${NUM_REQUESTS}"); do
            send_request "${i}" &
            running=$((running + 1))
            if [[ ${running} -ge ${CONCURRENCY} ]]; then
                wait -n 2>/dev/null || true
                running=$((running - 1))
            fi
        done
        # Wait for remaining background jobs
        wait
    fi
}

# ==============================================================================
# Post-Steps
# ==============================================================================
post_steps() {
{% if post_steps | default('') %}
    log "Running post-reproduction steps..."
    {{ post_steps | indent(4) }}
    log "${GREEN}[OK]${NC} Post-steps completed"
{% else %}
    log "No post-steps defined"
{% endif %}
}

# ==============================================================================
# Check for Expected Error in Logs
# ==============================================================================
check_logs() {
{% if expected_error | default('') %}
    log "Checking server logs for expected error pattern..."
    local server_log="{{ server_log_path | default('/opt/jboss/eap/standalone/log/server.log') }}"

    if [[ -f "${server_log}" ]]; then
        local pattern="{{ expected_error }}"
        local matches
        matches=$(grep -c "${pattern}" "${server_log}" 2>/dev/null || echo "0")

        if [[ "${matches}" -gt 0 ]]; then
            log "${GREEN}[REPRODUCED]${NC} Found ${matches} occurrence(s) of expected error:"
            log "  Pattern: ${pattern}"
            grep "${pattern}" "${server_log}" | tail -5 | while IFS= read -r line; do
                log "  >>> ${line}"
            done
        else
            log "${YELLOW}[NOT REPRODUCED]${NC} Expected error pattern not found"
            log "  Pattern: ${pattern}"
        fi
    else
        log "${YELLOW}[WARN]${NC} Server log not found: ${server_log}"
    fi
{% else %}
    log "No expected error pattern configured"
{% endif %}
}

# ==============================================================================
# Summary
# ==============================================================================
print_summary() {
    log "============================================"
    log "Reproduction Summary"
    log "============================================"
    log "  Total Requests: ${NUM_REQUESTS}"
    log "  Successful:     ${GREEN}${SUCCESS_COUNT}${NC}"
    log "  Failed (HTTP):  ${RED}${FAILURE_COUNT}${NC}"
    log "  Errors:         ${RED}${ERROR_COUNT}${NC}"
    log "  Results saved:  ${RESULT_FILE}"
    log "============================================"
}

# ==============================================================================
# Main
# ==============================================================================
main() {
    log "Starting reproduction..."
    pre_steps
    wait_for_server
    run_requests
    post_steps
    check_logs
    print_summary
}

main "$@"
