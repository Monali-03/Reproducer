#!/bin/bash
# ==============================================================================
# Cleanup Script for Reproducer Environment
# Generated by Red Hat Reproducer Agent
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log() { echo -e "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# ==============================================================================
# Stop Servers
# ==============================================================================
stop_servers() {
    log "Stopping servers..."

    # Stop via PID file
    local pid_file="{{ pid_file | default('${SCRIPT_DIR}/server.pid') }}"
    if [[ -f "${pid_file}" ]]; then
        local pid
        pid=$(cat "${pid_file}")
        if kill -0 "${pid}" 2>/dev/null; then
            log "Sending SIGTERM to server PID ${pid}..."
            kill "${pid}"

            # Wait for graceful shutdown
            local waited=0
            local max_wait={{ shutdown_timeout | default('30') }}
            while kill -0 "${pid}" 2>/dev/null && [[ ${waited} -lt ${max_wait} ]]; do
                sleep 1
                waited=$((waited + 1))
            done

            if kill -0 "${pid}" 2>/dev/null; then
                log "${YELLOW}[WARN]${NC} Server did not stop gracefully, sending SIGKILL"
                kill -9 "${pid}" 2>/dev/null || true
            fi
            log "${GREEN}[OK]${NC} Server stopped"
        else
            log "No running process for PID ${pid}"
        fi
        rm -f "${pid_file}"
    fi

{% if server_home | default('') %}
    # Stop via JBoss CLI (EAP / WildFly)
    local cli="{{ server_home }}/bin/jboss-cli.sh"
    if [[ -x "${cli}" ]]; then
        log "Attempting shutdown via JBoss CLI..."
        "${cli}" --connect --command=":shutdown" 2>/dev/null || true
    fi
{% endif %}

    # Kill any remaining Java processes started from the server home
{% if server_home | default('') %}
    local remaining
    remaining=$(pgrep -f "{{ server_home }}" 2>/dev/null || true)
    if [[ -n "${remaining}" ]]; then
        log "${YELLOW}[WARN]${NC} Killing remaining server processes: ${remaining}"
        echo "${remaining}" | xargs kill 2>/dev/null || true
        sleep 2
        echo "${remaining}" | xargs kill -9 2>/dev/null || true
    fi
{% endif %}

    log "${GREEN}[OK]${NC} Server shutdown complete"
}

# ==============================================================================
# Remove Deployments
# ==============================================================================
remove_deployments() {
{% if server_home | default('') %}
    log "Removing deployments..."
    local deploy_dir="{{ server_home }}/standalone/deployments"
    if [[ -d "${deploy_dir}" ]]; then
        rm -f "${deploy_dir}"/*.war "${deploy_dir}"/*.ear "${deploy_dir}"/*.jar 2>/dev/null || true
        rm -f "${deploy_dir}"/*.deployed "${deploy_dir}"/*.failed "${deploy_dir}"/*.undeployed 2>/dev/null || true
        log "${GREEN}[OK]${NC} Deployments removed from ${deploy_dir}"
    fi
{% endif %}

{% if namespace | default('') %}
    # Remove OpenShift resources
    if command -v oc &>/dev/null; then
        log "Removing OpenShift resources in namespace {{ namespace }}..."
        oc delete all --all -n "{{ namespace }}" 2>/dev/null || true
        oc delete configmap --all -n "{{ namespace }}" 2>/dev/null || true
        oc delete secret --all -n "{{ namespace }}" 2>/dev/null || true
        oc delete pvc --all -n "{{ namespace }}" 2>/dev/null || true
        log "${GREEN}[OK]${NC} OpenShift resources removed"
    fi
{% endif %}
}

# ==============================================================================
# Clean Temporary Files
# ==============================================================================
clean_temp_files() {
    log "Cleaning temporary files..."

{% if server_home | default('') %}
    # Server data and tmp directories
    rm -rf "{{ server_home }}/standalone/data/"* 2>/dev/null || true
    rm -rf "{{ server_home }}/standalone/tmp/"* 2>/dev/null || true
    log "  Cleaned server data/tmp directories"
{% endif %}

    # Build artifacts
    local reproducer_home="{{ reproducer_home | default('${SCRIPT_DIR}/..') }}"
    if [[ -d "${reproducer_home}/app/target" ]]; then
        rm -rf "${reproducer_home}/app/target"
        log "  Cleaned Maven build output"
    fi

    # Cookie jars and temp files
    rm -f "${reproducer_home}/logs/cookies.txt" 2>/dev/null || true

{% for path in extra_cleanup_paths | default([]) %}
    rm -rf "{{ path }}" 2>/dev/null || true
    log "  Cleaned {{ path }}"
{% endfor %}

    log "${GREEN}[OK]${NC} Temporary files cleaned"
}

# ==============================================================================
# Custom Cleanup Steps
# ==============================================================================
custom_cleanup() {
{% if custom_cleanup | default('') %}
    log "Running custom cleanup steps..."
    {{ custom_cleanup | indent(4) }}
    log "${GREEN}[OK]${NC} Custom cleanup completed"
{% else %}
    log "No custom cleanup steps defined"
{% endif %}
}

# ==============================================================================
# Main
# ==============================================================================
main() {
    log "============================================"
    log "Reproducer Cleanup - Starting"
    log "============================================"

    stop_servers
    remove_deployments
    clean_temp_files
    custom_cleanup

    log "============================================"
    log "Reproducer Cleanup - Complete"
    log "============================================"
}

main "$@"
