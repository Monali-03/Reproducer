<?xml version="1.0" encoding="UTF-8"?>
<!--
  Infinispan / Red Hat Data Grid 8.x Server Configuration
  Generated by Red Hat Reproducer Agent
-->
<infinispan
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="urn:infinispan:config:14.0 https://infinispan.org/schemas/infinispan-config-14.0.xsd
                          urn:infinispan:server:14.0 https://infinispan.org/schemas/infinispan-server-14.0.xsd"
      xmlns="urn:infinispan:config:14.0"
      xmlns:server="urn:infinispan:server:14.0">

   <!-- ============================================================ -->
   <!-- JGroups Transport Configuration                               -->
   <!-- ============================================================ -->
   <jgroups>
      <stack name="{{ jgroups_stack | default('tcp') }}" extends="{{ jgroups_stack | default('tcp') }}">
{% if jgroups_discovery | default('') == 'dns' %}
         <!-- DNS_PING for Kubernetes/OpenShift environments -->
         <dns.DNS_PING dns_query="{{ dns_query | default('datagrid-ping.' ~ (namespace | default('reproducer')) ~ '.svc.cluster.local') }}"
                       stack.combine="REPLACE"
                       stack.position="MPING"/>
{% elif jgroups_discovery | default('') == 'kubernetes' %}
         <!-- Kubernetes API discovery -->
         <org.jgroups.protocols.kubernetes.KUBE_PING
                       stack.combine="REPLACE"
                       stack.position="MPING"/>
{% endif %}
      </stack>
   </jgroups>

   <!-- ============================================================ -->
   <!-- Cache Container                                               -->
   <!-- ============================================================ -->
   <cache-container name="{{ cluster_name | default('reproducer-cluster') }}"
                    statistics="{{ statistics_enabled | default('true') }}">
      <transport cluster="{{ cluster_name | default('reproducer-cluster') }}"
                 stack="{{ jgroups_stack | default('tcp') }}"
                 node-name="{{ node_name | default('') }}"/>

      <!-- Serialization context for custom types -->
      <serialization>
         <allow-list>
            <regex>com\.redhat\.reproducer\..*</regex>
{% for class_regex in serialization_allow_list | default([]) %}
            <regex>{{ class_regex }}</regex>
{% endfor %}
         </allow-list>
      </serialization>

      <!-- ======================================================== -->
      <!-- Distributed Cache: primary test cache                     -->
      <!-- ======================================================== -->
      <distributed-cache name="{{ cache_name | default('testCache') }}"
                         mode="{{ cache_mode | default('SYNC') }}"
                         owners="{{ num_owners | default('2') }}"
                         statistics="true">
         <encoding>
            <key media-type="{{ key_media_type | default('application/x-protostream') }}"/>
            <value media-type="{{ value_media_type | default('application/x-protostream') }}"/>
         </encoding>
         <locking isolation="{{ isolation_level | default('READ_COMMITTED') }}"
                  acquire-timeout="{{ lock_timeout | default('10000') }}"/>
         <transaction mode="{{ tx_mode | default('NONE') }}"/>
         <expiration lifespan="{{ expiration_lifespan | default('-1') }}"
                     max-idle="{{ expiration_max_idle | default('-1') }}"/>
         <memory max-count="{{ max_entries | default('10000') }}"
                 when-full="{{ eviction_strategy | default('REMOVE') }}"/>
{% if persistence_enabled | default(false) %}
         <persistence passivation="{{ passivation | default('false') }}">
            <file-store path="{{ persistence_path | default('data') }}">
               <data path="data"/>
               <index path="index"/>
            </file-store>
         </persistence>
{% endif %}
         <partition-handling when-split="{{ partition_handling | default('ALLOW_READ_WRITES') }}"
                            merge-policy="{{ merge_policy | default('PREFERRED_NON_NULL') }}"/>
{% if backup_site | default('') %}
         <!-- Cross-site replication -->
         <backups>
            <backup site="{{ backup_site }}"
                    strategy="{{ backup_strategy | default('ASYNC') }}"
                    timeout="{{ backup_timeout | default('15000') }}">
{% if state_transfer_enabled | default(true) %}
               <state-transfer chunk-size="{{ state_transfer_chunk_size | default('512') }}"
                               timeout="{{ state_transfer_timeout | default('1200000') }}"/>
{% endif %}
            </backup>
{% for extra_site in additional_backup_sites | default([]) %}
            <backup site="{{ extra_site.name }}"
                    strategy="{{ extra_site.strategy | default('ASYNC') }}"
                    timeout="{{ extra_site.timeout | default('15000') }}"/>
{% endfor %}
         </backups>
{% endif %}
      </distributed-cache>

      <!-- ======================================================== -->
      <!-- Replicated Cache: session data                            -->
      <!-- ======================================================== -->
      <replicated-cache name="{{ session_cache_name | default('sessions') }}"
                        mode="SYNC"
                        statistics="true">
         <encoding>
            <key media-type="application/x-protostream"/>
            <value media-type="application/x-protostream"/>
         </encoding>
         <locking isolation="REPEATABLE_READ"
                  acquire-timeout="15000"/>
         <transaction mode="{{ session_tx_mode | default('NON_XA') }}"
                      locking="{{ session_tx_locking | default('PESSIMISTIC') }}"/>
         <expiration lifespan="{{ session_lifespan | default('3600000') }}"
                     max-idle="{{ session_max_idle | default('1800000') }}"/>
         <memory max-count="{{ session_max_entries | default('5000') }}"
                 when-full="REMOVE"/>
      </replicated-cache>

{% for extra_cache in additional_caches | default([]) %}
      <!-- Additional cache: {{ extra_cache.name }} -->
      <{{ extra_cache.type | default('distributed-cache') }} name="{{ extra_cache.name }}"
                         mode="{{ extra_cache.mode | default('SYNC') }}"
{% if extra_cache.type | default('distributed-cache') == 'distributed-cache' %}
                         owners="{{ extra_cache.owners | default('2') }}"
{% endif %}
                         statistics="true">
         <encoding>
            <key media-type="{{ extra_cache.key_type | default('application/x-protostream') }}"/>
            <value media-type="{{ extra_cache.value_type | default('application/x-protostream') }}"/>
         </encoding>
      </{{ extra_cache.type | default('distributed-cache') }}>
{% endfor %}
   </cache-container>

   <!-- ============================================================ -->
   <!-- Server Configuration                                          -->
   <!-- ============================================================ -->
   <server xmlns="urn:infinispan:server:14.0">

      <!-- ======================================================== -->
      <!-- Network Interfaces                                        -->
      <!-- ======================================================== -->
      <interfaces>
         <interface name="public">
            <inet-address value="{{ bind_address | default('${infinispan.bind.address:0.0.0.0}') }}"/>
         </interface>
      </interfaces>

      <!-- ======================================================== -->
      <!-- Socket Bindings                                           -->
      <!-- ======================================================== -->
      <socket-bindings default-interface="public"
                       port-offset="{{ port_offset | default('${infinispan.socket.binding.port-offset:0}') }}">
         <socket-binding name="default"
                         port="{{ hotrod_port | default('11222') }}"/>
{% if metrics_enabled | default(true) %}
         <socket-binding name="metrics"
                         port="{{ metrics_port | default('11223') }}"/>
{% endif %}
      </socket-bindings>

      <!-- ======================================================== -->
      <!-- Security                                                  -->
      <!-- ======================================================== -->
      <security>
         <credential-stores>
            <credential-store name="credentials"
                              path="credentials.pfx">
               <clear-text-credential clear-text="{{ credential_store_password | default('secret') }}"/>
            </credential-store>
         </credential-stores>

         <security-realms>
            <security-realm name="{{ security_realm | default('default') }}">
               <!-- Properties-based authentication -->
               <properties-realm groups-attribute="Roles">
                  <user-properties path="users.properties"/>
                  <group-properties path="groups.properties"/>
               </properties-realm>
{% if ldap_enabled | default(false) %}
               <!-- LDAP authentication -->
               <ldap-realm name="ldap"
                           url="{{ ldap_url }}"
                           principal="{{ ldap_principal }}"
                           credential="{{ ldap_credential }}">
                  <identity-mapping rdn-identifier="{{ ldap_rdn | default('uid') }}"
                                    search-dn="{{ ldap_search_dn }}">
                     <attribute-mapping>
                        <attribute from="{{ ldap_group_attr | default('cn') }}"
                                   to="Roles"
                                   filter="{{ ldap_group_filter | default('(&(objectClass=groupOfNames)(member={1}))') }}"
                                   filter-dn="{{ ldap_group_search_dn | default(ldap_search_dn) }}"/>
                     </attribute-mapping>
                  </identity-mapping>
               </ldap-realm>
{% endif %}
{% if truststore_enabled | default(false) %}
               <server-identities>
                  <ssl>
                     <keystore path="{{ keystore_path | default('server.pfx') }}"
                               keystore-password="{{ keystore_password | default('secret') }}"
                               alias="{{ keystore_alias | default('server') }}"/>
                     <truststore path="{{ truststore_path | default('truststore.pfx') }}"
                                 password="{{ truststore_password | default('secret') }}"/>
                  </ssl>
               </server-identities>
{% endif %}
            </security-realm>
         </security-realms>
      </security>

      <!-- ======================================================== -->
      <!-- Endpoints (Hot Rod + REST)                                -->
      <!-- ======================================================== -->
      <endpoints socket-binding="default"
                 security-realm="{{ security_realm | default('default') }}">
         <hotrod-connector name="hotrod">
            <authentication>
               <sasl mechanisms="{{ sasl_mechanisms | default('SCRAM-SHA-512 SCRAM-SHA-384 SCRAM-SHA-256 SCRAM-SHA-1 DIGEST-SHA-512 DIGEST-SHA-384 DIGEST-SHA-256 DIGEST-SHA DIGEST-MD5') }}"
                     server-name="{{ sasl_server_name | default('infinispan') }}"
                     qop="{{ sasl_qop | default('auth') }}"/>
            </authentication>
         </hotrod-connector>
         <rest-connector name="rest">
            <authentication mechanisms="{{ rest_auth_mechanisms | default('DIGEST BASIC') }}"/>
{% if cors_enabled | default(false) %}
            <cors-rules>
               <cors-rule name="allow-all"
                          allow-credentials="true"
                          max-age-seconds="3600">
                  <allowed-origins>{{ cors_origins | default('*') }}</allowed-origins>
                  <allowed-methods>GET,PUT,POST,DELETE,OPTIONS</allowed-methods>
                  <allowed-headers>Content-Type,Authorization</allowed-headers>
               </cors-rule>
            </cors-rules>
{% endif %}
         </rest-connector>
      </endpoints>
   </server>
</infinispan>
